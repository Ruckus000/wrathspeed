{
  "_comment": [
    "Maps every movement id in strength_catalog.json and movement_catalog.json to the",
    "artwork used to build its looping demo clip.",
    "",
    "Source tiers, in preference order:",
    "  1. gifdb  - 3D anatomical render, working muscles highlighted red, white background,",
    "              already animated. This is the house style. Covers gym strength and most",
    "              static stretches; thin on running drills and foam rolling.",
    "  2. photo  - photographic demo of a real person, start + end frame. Used only where",
    "              tier 1 has no honest match. Built into a loop by crossfading the two frames.",
    "  3. none   - no honest match in either set. The app falls back to the movement's",
    "              SF Symbol. Never map a movement to artwork of a DIFFERENT movement just",
    "              to fill the slot.",
    "",
    "'approximate' marks a clip whose artwork shows a close variant rather than the exact",
    "movement. The clip still teaches the pattern; the cue text governs the details."
  ],
  "sources": {
    "gifdb": {
      "repo": "https://github.com/JahelCuadrado/ExerciseGymGifsDB",
      "rawBase": "https://raw.githubusercontent.com/JahelCuadrado/ExerciseGymGifsDB/main",
      "style": "anatomical-render",
      "kind": "animated-gif"
    },
    "photo": {
      "repo": "https://github.com/yuhonas/free-exercise-db",
      "rawBase": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises",
      "style": "photo",
      "kind": "image-pair"
    }
  },
  "mappings": {
    "bw-squat": { "source": "photo", "ref": "Bodyweight_Squat", "reason": "gifdb has no plain air squat" },
    "split-squat": { "source": "gifdb", "ref": "quads/split-squats.gif" },
    "reverse-lunge": { "source": "gifdb", "ref": "glutes/walking-lunge.gif", "approximate": "walking lunge, not a reverse step" },
    "glute-bridge": { "source": "gifdb", "ref": "glutes/low-glute-bridge-on-floor.gif" },
    "single-leg-bridge": { "source": "gifdb", "ref": "glutes/single-leg-bridge-with-outstretched-leg.gif" },
    "calf-raise": { "source": "gifdb", "ref": "calves/bodyweight-standing-calf-raise.gif" },
    "side-plank": { "source": "gifdb", "ref": "abs/side-bridge-v-2.gif" },
    "dead-bug": { "source": "gifdb", "ref": "abs/dead-bug.gif" },
    "bird-dog": { "source": "none", "reason": "no bird dog in either set; nearest candidates are a different movement" },
    "push-up": { "source": "gifdb", "ref": "pectorals/push-up.gif" },
    "band-row": { "source": "gifdb", "ref": "upper-back/resistance-band-seated-straight-back-row.gif" },
    "db-row": { "source": "gifdb", "ref": "upper-back/dumbbell-bent-over-row.gif" },
    "goblet-squat": { "source": "gifdb", "ref": "quads/dumbbell-goblet-squat.gif" },
    "rdl": { "source": "gifdb", "ref": "glutes/dumbbell-romanian-deadlift.gif" },
    "step-up": { "source": "gifdb", "ref": "glutes/dumbbell-step-up.gif" },
    "hip-thrust": { "source": "photo", "ref": "Barbell_Hip_Thrust", "reason": "gifdb only has a banded on-knees variant" },
    "pull-up": { "source": "gifdb", "ref": "lats/pull-up.gif" },
    "swiss-crunch": { "source": "gifdb", "ref": "abs/crunch-on-stability-ball.gif" },
    "farmer-carry": { "source": "gifdb", "ref": "quads/farmers-walk.gif" },
    "plank": { "source": "photo", "ref": "Plank", "reason": "gifdb only has plank variants with a twist or shoulder tap" },

    "arm-circles": { "source": "photo", "ref": "Arm_Circles" },
    "cat-cow": { "source": "photo", "ref": "Cat_Stretch" },
    "standing-pelvic-tilt": { "source": "gifdb", "ref": "spine/standing-pelvic-tilt.gif" },
    "hip-circles": { "source": "photo", "ref": "Standing_Hip_Circles" },
    "ankle-circles": { "source": "gifdb", "ref": "calves/ankle-circles.gif" },
    "leg-swings-front": { "source": "photo", "ref": "Front_Leg_Raises" },
    "leg-swings-side": { "source": "photo", "ref": "Side_Leg_Raises" },
    "groiners": { "source": "photo", "ref": "Groiners" },
    "worlds-greatest-stretch": { "source": "gifdb", "ref": "hamstrings/world-greatest-stretch.gif" },
    "inchworm": { "source": "gifdb", "ref": "abs/inchworm.gif" },

    "arm-drill": { "source": "photo", "ref": "Kneeling_Arm_Drill" },
    "wall-drill": { "source": "gifdb", "ref": "cardio/high-knee-against-wall.gif" },
    "claw-series": { "source": "photo", "ref": "Moving_Claw_Series" },
    "butt-kicks": { "source": "photo", "ref": "Double_Leg_Butt_Kick" },
    "single-leg-butt-kick": { "source": "photo", "ref": "Single_Leg_Butt_Kick" },
    "fast-skipping": { "source": "photo", "ref": "Fast_Skipping" },
    "carioca": { "source": "photo", "ref": "Carioca_Quick_Step" },
    "lateral-bound": { "source": "gifdb", "ref": "cardio/skater-hops.gif" },
    "diagonal-bound": { "source": "photo", "ref": "Alternate_Leg_Diagonal_Bound" },
    "split-jump": { "source": "gifdb", "ref": "cardio/scissor-jumps-male.gif" },
    "knee-tuck-jump": { "source": "photo", "ref": "Knee_Tuck_Jump" },
    "hurdle-hops": { "source": "photo", "ref": "Front_Cone_Hops_or_hurdle_hops" },

    "calf-stretch-wall": { "source": "gifdb", "ref": "calves/calf-stretch-with-hands-against-wall.gif" },
    "soleus-achilles": { "source": "gifdb", "ref": "calves/calf-push-stretch-with-hands-against-wall.gif" },
    "runners-stretch": { "source": "gifdb", "ref": "hamstrings/runners-stretch.gif" },
    "seated-hamstring": { "source": "gifdb", "ref": "hamstrings/hamstring-stretch.gif" },
    "kneeling-hip-flexor": { "source": "gifdb", "ref": "quads/intermediate-hip-flexor-and-quad-stretch.gif" },
    "quad-stretch": { "source": "photo", "ref": "Quad_Stretch", "reason": "gifdb quad stretches are all-fours or side-lying, not standing" },
    "it-band-glute": { "source": "photo", "ref": "IT_Band_and_Glute_Stretch" },
    "lying-glute": { "source": "gifdb", "ref": "glutes/assisted-lying-glutes-stretch.gif" },
    "lying-crossover": { "source": "photo", "ref": "Lying_Crossover" },
    "side-lying-groin": { "source": "gifdb", "ref": "adductors/assisted-side-lying-adductor-stretch.gif" },
    "hug-knees-to-chest": { "source": "photo", "ref": "Hug_Knees_To_Chest" },
    "childs-pose": { "source": "photo", "ref": "Childs_Pose" },
    "calves-smr": { "source": "photo", "ref": "Calves-SMR" },
    "hamstring-smr": { "source": "photo", "ref": "Hamstring-SMR" },
    "it-band-smr": { "source": "photo", "ref": "Iliotibial_Tract-SMR" },
    "piriformis-smr": { "source": "photo", "ref": "Piriformis-SMR" }
  }
}
