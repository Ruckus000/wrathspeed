<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Wrathspeed reads heart rate and workout data to coach your runs.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Wrathspeed saves completed runs and strength sessions to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wrathspeed uses your location to track outdoor runs.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Wrathspeed records your outdoor route while a workout is active, including when the screen is locked.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>workout-processing</string>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIAppFonts</key>
	<array>
		<string>Anton-Regular.ttf</string>
		<string>Archivo-Variable.ttf</string>
	</array>
</dict>
</plist>
